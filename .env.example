# Telegram User API (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# OpenAI / OpenRouter API Configuration
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-001

# Logging
LOG_LEVEL=INFO

# Telebrief runtime/storage
TELEBRIEF_CHAT_DB_PATH=data/telebrief.db
TELEBRIEF_RUNTIME_SETTINGS_PATH=data/runtime_settings.json

# Version/build identifier shown by /version
# TELEBRIEF_BUILD_ID=main-2026-01-30
